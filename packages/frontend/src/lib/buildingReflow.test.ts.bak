import { describe, it, expect } from "vitest";
import type { Waypoint } from "@droneroute/shared";
import { DEFAULT_WAYPOINT } from "@droneroute/shared";
import { computeBuildingReflow } from "./buildingReflow";
import { computeOrbitSeedForBuilding, destinationPoint } from "./templates";
import { haversineDistance } from "./geo";

/** Square footprint of `sideM` meters centred on [lat, lng]. */
function square(
  lat: number,
  lng: number,
  sideM: number,
): [number, number][] {
  const h = sideM / 2;
  return [
    destinationPoint(destinationPoint(lat, lng, h, 0)[0], lng, h, 90),
    destinationPoint(destinationPoint(lat, lng, h, 0)[0], lng, h, 270),
    destinationPoint(destinationPoint(lat, lng, -h, 0)[0], lng, h, 270),
    destinationPoint(destinationPoint(lat, lng, -h, 0)[0], lng, h, 90),
  ];
}

function wp(
  index: number,
  latitude: number,
  longitude: number,
  locked = false,
): Waypoint {
  return {
    ...DEFAULT_WAYPOINT,
    index,
    name: `Bod trasy ${index + 1}`,
    latitude,
    longitude,
    ...(locked ? { locked: true } : {}),
  };
}

const CENTER: [number, number] = [50.06, 14.43];
const HEIGHT = 30;

/** Waypoints evenly spread on the orbit ring the given footprint recommends. */
function ringWaypoints(
  vertices: [number, number][],
  count: number,
  lockedIndices: number[] = [],
): Waypoint[] {
  const seed = computeOrbitSeedForBuilding(vertices, HEIGHT);
  return Array.from({ length: count }, (_, i) => {
    const [lat, lng] = destinationPoint(
      seed.center[0],
      seed.center[1],
      seed.radiusM,
      (360 / count) * i,
    );
    return wp(i, lat, lng, lockedIndices.includes(i));
  });
}

describe("computeBuildingReflow", () => {
  const oldVertices = square(CENTER[0], CENTER[1], 40);
  const biggerVertices = square(CENTER[0], CENTER[1], 80);

  it("returns null when the footprint is unchanged", () => {
    const waypoints = ringWaypoints(oldVertices, 8);
    expect(
      computeBuildingReflow({
        oldVertices,
        newVertices: oldVertices,
        oldHeight: HEIGHT,
        newHeight: HEIGHT,
        waypoints,
      }),
    ).toBeNull();
  });

  it("returns null when every waypoint is locked", () => {
    const waypoints = ringWaypoints(oldVertices, 4, [0, 1, 2, 3]);
    expect(
      computeBuildingReflow({
        oldVertices,
        newVertices: biggerVertices,
        oldHeight: HEIGHT,
        newHeight: HEIGHT,
        waypoints,
      }),
    ).toBeNull();
  });

  it("returns null when the mission has no waypoints", () => {
    expect(
      computeBuildingReflow({
        oldVertices,
        newVertices: biggerVertices,
        oldHeight: HEIGHT,
        newHeight: HEIGHT,
        waypoints: [],
      }),
    ).toBeNull();
  });

  it("returns null for a degenerate footprint", () => {
    expect(
      computeBuildingReflow({
        oldVertices: [
          [50.06, 14.43],
          [50.061, 14.43],
        ],
        newVertices: biggerVertices,
        oldHeight: HEIGHT,
        newHeight: HEIGHT,
        waypoints: ringWaypoints(oldVertices, 4),
      }),
    ).toBeNull();
  });

  it("pushes unlocked ring waypoints out to the new radius, keeping their bearing", () => {
    const waypoints = ringWaypoints(oldVertices, 8);
    const oldSeed = computeOrbitSeedForBuilding(oldVertices, HEIGHT);
    const newSeed = computeOrbitSeedForBuilding(biggerVertices, HEIGHT);
    expect(newSeed.radiusM).toBeGreaterThan(oldSeed.radiusM);

    const result = computeBuildingReflow({
      oldVertices,
      newVertices: biggerVertices,
      oldHeight: HEIGHT,
      newHeight: HEIGHT,
      waypoints,
    });

    expect(result).not.toBeNull();
    expect(result!.moves).toHaveLength(8);
    expect(result!.oldRadiusM).toBe(oldSeed.radiusM);
    expect(result!.newRadiusM).toBe(newSeed.radiusM);

    for (const move of result!.moves) {
      const dist = haversineDistance(
        newSeed.center[0],
        newSeed.center[1],
        move.latitude,
        move.longitude,
      );
      expect(dist).toBeCloseTo(newSeed.radiusM, 0);
    }
  });

  it("leaves locked waypoints out of the result entirely", () => {
    const waypoints = ringWaypoints(oldVertices, 8, [0, 1, 2, 3, 4]);
    const result = computeBuildingReflow({
      oldVertices,
      newVertices: biggerVertices,
      oldHeight: HEIGHT,
      newHeight: HEIGHT,
      waypoints,
    });

    expect(result!.moves.map((m) => m.index)).toEqual([5, 6, 7]);
    expect(result!.lockedCount).toBe(5);
    expect(result!.movedCount).toBe(3);
  });

  it("follows the centroid when the footprint moves without changing size", () => {
    const shifted = square(
      destinationPoint(CENTER[0], CENTER[1], 25, 90)[0],
      destinationPoint(CENTER[0], CENTER[1], 25, 90)[1],
      40,
    );
    const waypoints = ringWaypoints(oldVertices, 6);
    const result = computeBuildingReflow({
      oldVertices,
      newVertices: shifted,
      oldHeight: HEIGHT,
      newHeight: HEIGHT,
      waypoints,
    });

    expect(result).not.toBeNull();
    const newSeed = computeOrbitSeedForBuilding(shifted, HEIGHT);
    for (const move of result!.moves) {
      const dist = haversineDistance(
        newSeed.center[0],
        newSeed.center[1],
        move.latitude,
        move.longitude,
      );
      expect(dist).toBeCloseTo(newSeed.radiusM, 0);
    }
  });

  it("keeps a waypoint that sits off the ring off the ring by the same amount", () => {
    const oldSeed = computeOrbitSeedForBuilding(oldVertices, HEIGHT);
    const newSeed = computeOrbitSeedForBuilding(biggerVertices, HEIGHT);
    const offset = 25;
    const [lat, lng] = destinationPoint(
      oldSeed.center[0],
      oldSeed.center[1],
      oldSeed.radiusM + offset,
      45,
    );

    const result = computeBuildingReflow({
      oldVertices,
      newVertices: biggerVertices,
      oldHeight: HEIGHT,
      newHeight: HEIGHT,
      waypoints: [wp(0, lat, lng)],
    });

    const move = result!.moves[0];
    const dist = haversineDistance(
      newSeed.center[0],
      newSeed.center[1],
      move.latitude,
      move.longitude,
    );
    expect(dist).toBeCloseTo(newSeed.radiusM + offset, 0);
  });

  it("never pulls a waypoint through the new centroid when the building shrinks hard", () => {
    const tiny = square(CENTER[0], CENTER[1], 2);
    const oldSeed = computeOrbitSeedForBuilding(biggerVertices, HEIGHT);
    const [lat, lng] = destinationPoint(
      oldSeed.center[0],
      oldSeed.center[1],
      1,
      0,
    );

    const result = computeBuildingReflow({
      oldVertices: biggerVertices,
      newVertices: tiny,
      oldHeight: HEIGHT,
      newHeight: HEIGHT,
      waypoints: [wp(0, lat, lng)],
    });

    const move = result!.moves[0];
    const newSeed = computeOrbitSeedForBuilding(tiny, HEIGHT);
    const dist = haversineDistance(
      newSeed.center[0],
      newSeed.center[1],
      move.latitude,
      move.longitude,
    );
    expect(dist).toBeGreaterThan(0);
  });

  it("reacts to a height change alone, since height drives the standoff floor", () => {
    const waypoints = ringWaypoints(oldVertices, 6);
    const result = computeBuildingReflow({
      oldVertices,
      newVertices: oldVertices,
      oldHeight: HEIGHT,
      newHeight: HEIGHT * 3,
      waypoints,
    });

    expect(result).not.toBeNull();
    expect(result!.newRadiusM).toBeGreaterThan(result!.oldRadiusM);
  });

  it("does not touch height, speed or gimbal pitch", () => {
    const waypoints = ringWaypoints(oldVertices, 4);
    const result = computeBuildingReflow({
      oldVertices,
      newVertices: biggerVertices,
      oldHeight: HEIGHT,
      newHeight: HEIGHT,
      waypoints,
    });

    for (const move of result!.moves) {
      expect(Object.keys(move).sort()).toEqual([
        "index",
        "latitude",
        "longitude",
      ]);
    }
  });
});
